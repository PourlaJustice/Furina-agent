{
  "name": "furina-agent",
  "version": "0.1.0",
  "description": "Live2D desktop pet — Furina",
  "main": "dist/main/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "dev": "npm run build:main && npm run build:preload && concurrently \"vite\" \"cross-env VITE_DEV=1 electron .\"",
    "start": "electron .",
    "build:screenshot-helper": "node scripts/build-screenshot-helper.mjs",
    "verify:screenshot-helper": "node scripts/verify-screenshot-helper.mjs"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-filesystem": "^2026.7.10",
    "@playwright/mcp": "^0.0.78",
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^43.2.0",
    "qweather-mcp": "^2.0.0",
    "qwen-vision-mcp-server": "^1.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@langchain/community": "^1.1.28",
    "@langchain/core": "^1.2.4",
    "@langchain/deepseek": "^1.1.5",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/openai": "^1.5.6",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/markdown-it": "^14.1.2",
    "@xenova/transformers": "^2.17.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "markdown-it": "^15.0.0",
    "mcp-sqlite-server": "^1.0.1",
    "pixi-live2d-display": "^0.5.0-beta",
    "pixi.js": "^7.4.3",
    "unpdf": "^1.8.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "overrides": {
    "better-sqlite3": "^12.11.1"
  }
}
